msgctxt "L_ARK_009"
msgid "Access foyer elevator\n"
msgstr "Acceder al ascensor del vestíbulo\n"

msgctxt "L_ARK_010"
msgid "Reactivate office elevator\n"
msgstr "Reactivar ascensor de las oficinas\n"

msgctxt "L_ARK_011"
msgid "Destroy dataDyne hovercopter\n"
msgstr "Destruir helicóptero de dataDyne\n"

msgctxt "L_ARK_012"
msgid "Defeat Cassandra's bodyguards\n"
msgstr "Derrotar a las guard. de Cassandra\n"

msgctxt "L_ARK_013"
msgid "Rendezvous at helipad\n"
msgstr "Encuentro en el helipuerto\n"

msgctxt "L_ARK_014"
msgid "Accessing elevator controls...\n"
msgstr "Accediendo a los controles del ascensor...\n"

msgctxt "L_ARK_015"
msgid "LIGHTS ARE NOW ON!\n"
msgstr "¡LUCES ENCENDIDAS!\n"

msgctxt "L_ARK_016"
msgid "Dr. Caroll has been killed!\n"
msgstr "¡El Dr. Caroll ha muerto!\n"

msgctxt "L_ARK_017"
msgid "Dr. Caroll is under attack!\n"
msgstr "¡Están atacando al Dr. Caroll!\n"

msgctxt "L_ARK_018"
msgid "Dr. Caroll has been damaged!\n"
msgstr "¡El Dr. Caroll ha sido dañado!\n"

msgctxt "L_ARK_019"
msgid "Too late! She's here...\n"
msgstr "¡Demasiado tarde! Ella está aquí...\n"

msgctxt "L_ARK_020"
msgid "You've become quite an annoyance...\n"
msgstr "Estás empezando a ser un fastidio...\n"

msgctxt "L_ARK_021"
msgid "Good night, Ms. Dark.\n"
msgstr "Buenas noches, Srta. Dark.\n"

msgctxt "L_ARK_022"
msgid "LIGHTS NOW ON\n"
msgstr "LUCES ENCENDIDAS\n"

msgctxt "L_ARK_023"
msgid "LIGHTS NOW OFF\n"
msgstr "LUCES APAGADAS\n"

msgctxt "L_ARK_024"
msgid "MISSION FAILED\n"
msgstr "MISIÓN FALLADA\n"

msgctxt "L_ARK_025"
msgid "MISSION SUCCESSFUL\n"
msgstr "MISIÓN CUMPLIDA\n"

msgctxt "L_ARK_026"
msgid "Helichopper warning goes here.\n"
msgstr "Aviso del Helicóptero va aquí.\n"

msgctxt "L_ARK_027"
msgid "Obtain Night Vision.\n"
msgstr "Obtén Visión Nocturna.\n"

msgctxt "L_ARK_028"
msgid "Cassandra De Vries'\n"
msgstr "Cassandra De Vries:\n"

msgctxt "L_ARK_029"
msgid "Night Vision\n"
msgstr "V. Nocturna\n"

msgctxt "L_ARK_030"
msgid "Night Vision\n"
msgstr "Visión Nocturna\n"

msgctxt "L_ARK_031"
msgid "Picked up Night Vision.\n"
msgstr "Visión Nocturna obtenida.\n"

msgctxt "L_ARK_032"
msgid "We meet again, girl!\n"
msgstr "¡Nos vemos de nuevo, chica!\n"

msgctxt "L_ARK_033"
msgid "Foyer elevator accessed.\n"
msgstr "Accediste al ascensor del vestíbulo.\n"

msgctxt "L_ARK_034"
msgid "Office elevator door has been unlocked.\n"
msgstr "La puerta del ascensor a las oficinas ha sido abierta.\n"

msgctxt "L_ARK_035"
msgid "DataDyne Hovercopter eliminated.\n"
msgstr "Helicóptero de dataDyne eliminado.\n"

msgctxt "L_ARK_036"
msgid "Cassandra's bodyguards have been defeated.\n"
msgstr "Las guardaespaldas de Cassandra han sido derrotadas.\n"

msgctxt "L_ARK_037"
msgid "That's not how it goes.\n"
msgstr "Así no es como va.\n"

msgctxt "L_ARK_038"
msgid "Yes, it is.\n"
msgstr "Sí, así es.\n"

msgctxt "L_ARK_039"
msgid "Give it to me - you're doing it wrong.\n"
msgstr "Dámelo. Lo estás haciendo mal.\n"

msgctxt "L_ARK_040"
msgid "Stop annoying me.\n"
msgstr "Deja de molestarme.\n"

msgctxt "L_ARK_041"
msgid "Will you just hurry up!\n"
msgstr "¡Debemos darnos prisa!\n"

msgctxt "L_ARK_042"
msgid "Oh, no...too late.\n"
msgstr "Oh, no... demasiado tarde.\n"

msgctxt "L_ARK_043"
msgid "She's here...\n"
msgstr "Ella está aquí...\n"

msgctxt "L_ARK_044"
msgid "Get her!\n"
msgstr "¡Cogedla!\n"

msgctxt "L_ARK_045"
msgid "Critical mission object destroyed. \n"
msgstr "Objeto crítico de la misión destruido. \n"

msgctxt "L_ARK_046"
msgid "Obtain CamSpy.\n"
msgstr "Obtén la Cámara Espía.\n"

msgctxt "L_ARK_047"
msgid "Dr. Caroll's\n"
msgstr "Dr. Caroll:\n"

msgctxt "L_ARK_048"
msgid "CamSpy\n"
msgstr "Cámara Espía\n"

msgctxt "L_ARK_049"
msgid "A CamSpy\n"
msgstr "Una Cámara Espía\n"

msgctxt "L_ARK_050"
msgid "Picked up a CamSpy.\n"
msgstr "Cámara Espía obtenida.\n"

msgctxt "L_ARK_051"
msgid ""
"They've locked down the ground floor - \n"
"get to the elevator!\n"
msgstr ""
"Han cerrado la planta baja. \n"
"¡Ve al ascensor!\n"

msgctxt "L_ARK_052"
msgid ""
"That copter needs to be taken out, or \n"
"the jumpship'll get shot down!\n"
msgstr ""
"¡Necesitamos acabar con ese helicóptero, \n"
"o derribará la nave de escape!\n"

msgctxt "L_ARK_053"
msgid "I can't leave any bodyguards standing.\n"
msgstr "No puedo dejar ninguna guardaespaldas en pie.\n"

msgctxt "L_ARK_054"
msgid ""
"Don't keep the jumpship waiting - \n"
"get back to the landing pad.\n"
msgstr ""
"No hagas esperar a la nave de escape: \n"
"vuelve a la zona de aterrizaje.\n"

msgctxt "L_ARK_055"
msgid "Obtain alpha key card.\n"
msgstr "Obtén la llave magnética alfa.\n"

msgctxt "L_ARK_056"
msgid "Guard's\n"
msgstr "Guarda:\n"

msgctxt "L_ARK_057"
msgid "Office key card\n"
msgstr "Llave de la oficina\n"

msgctxt "L_ARK_058"
msgid "Office key card\n"
msgstr "Llave magnética de la oficina\n"

msgctxt "L_ARK_059"
msgid "Picked up Cassandra's office key card.\n"
msgstr "Llave magnética de la oficina de Cassandra obtenida.\n"

msgctxt "L_ARK_060"
msgid "Sound the alarm - she's here!\n"
msgstr "Activa la alarma: ¡ella está aquí!\n"

msgctxt "L_ARK_061"
msgid "Lights out!\n"
msgstr "¡Luces fuera!\n"

msgctxt "L_ARK_062"
msgid "What the...?\n"
msgstr "¿Qué dem...?\n"

msgctxt "L_ARK_063"
msgid "Going somewhere?\n"
msgstr "¿Vas a alguna parte?\n"

msgctxt "L_ARK_064"
msgid "Something I can do for you, old woman?\n"
msgstr "¿Puedo hacer algo por ti, anciana?\n"

msgctxt "L_ARK_065"
msgid ""
"Return our sapient immediately! You don't \n"
"know what you're doing.\n"
msgstr ""
"¡Devuelve nuestra IA inmediatamente! No sabes \n"
"lo que estás haciendo.\n"

msgctxt "L_ARK_066"
msgid "Yes I do. I'm leaving.\n"
msgstr "Sí lo sé. Me largo.\n"

msgctxt "L_ARK_067"
msgid ""
"One more chance! Give it back, and you \n"
"could come and work for me.\n"
msgstr ""
"¡Otra oportunidad! Devuélvelo, y podrás \n"
"trabajar para mí.\n"

msgctxt "L_ARK_068"
msgid "Sorry! Gotta shoot.\n"
msgstr "¡Lo siento! ¿Lo pillas?\n"

msgctxt "L_ARK_069"
msgid ""
"You must get the sapient back. We cannot \n"
"proceed without it.\n"
msgstr ""
"Debes traer de vuelta la IA. No podemos \n"
"avanzar sin ella.\n"

msgctxt "L_ARK_070"
msgid "I know that!\n"
msgstr "¡Ya lo sé!\n"

msgctxt "L_ARK_071"
msgid ""
"I also know who to talk to... \n"
"Mr. Carrington.\n"
msgstr ""
"También sé con quién hablar... \n"
"con el Sr. Carrington.\n"

msgctxt "L_ARK_072"
msgid "Elevator door is inactive on this floor.\n"
msgstr "La puerta del ascensor no funciona en este piso.\n"
