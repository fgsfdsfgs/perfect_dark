#. L_WAX_004
msgid "Locate and escort Cassandra to helipad\n"
msgstr "カサンドラを連行せよ\n"

#. L_WAX_005
msgid "Plant explosive device in lab lift\n"
msgstr "エレベーターに爆弾をセット\n"

#. L_WAX_006
msgid "Eliminate dataDyne Captain\n"
msgstr "ボディガードリーダーを倒せ\n"

#. L_WAX_007
msgid "Get the hell out of my office...\n"
msgstr "私のオフィスから出て行きなさい！\n"

#. L_WAX_008
msgid "Go to the helipad if you want to live.\n"
msgstr "命が惜しかったらヘリポートへすぐ行くんだ！\n"

#. L_WAX_009
msgid "You won't shoot me!\n"
msgstr "この私を撃てるわけがないわ。\n"

#. L_WAX_010
msgid "How dare you disturb me!\n"
msgstr "私に向かって何という態度なの！\n"

#. L_WAX_011
msgid "You will regret this intrusion, girl.\n"
msgstr "今に後悔するよ…\n"

#. L_WAX_012
msgid "If I were you, I'd leave... NOW!\n"
msgstr "私があなたの立場なら、すぐここを去るわね！\n"

#. L_WAX_013
msgid "You won't shoot me!\n"
msgstr "この私を撃てるわけがないわ。\n"

#. L_WAX_014
msgid "Cassandra has been immobilized.\n"
msgstr "カサンドラは動けなくなった。\n"

#. L_WAX_015
msgid "Cassandra has been captured successfully.\n"
msgstr "カサンドラは無事に捕獲された。\n"

#. L_WAX_016
msgid "Security chief has been eliminated.\n"
msgstr "ボディガードのリーダーを倒した。\n"

#. L_WAX_017
msgid "\n"
msgstr "\n"

