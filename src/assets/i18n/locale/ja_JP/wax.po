msgstr "スケダー爆弾\n"

#. L_WAX_020
msgid "Skedar bomb\n"
msgstr "スケダー爆弾\n"

#. L_WAX_021
msgid "Picked up Skedar bomb.\n"
msgstr "スケダー爆弾を手に入れた。\n"

#. L_WAX_022
msgid "Skedar bomb has been placed successfully.\n"
msgstr "スケダー爆弾が正しくセットされた。\n"

#. L_WAX_023
msgid "Skedar bomb has detonated.\n"
msgstr "スケダー爆弾が爆発した。\n"

#. L_WAX_024
msgid "Lift doors locked - bomb cannot be placed.\n"
msgstr ""
"エレベーターのドアがロックされています\n"
"爆弾を取りつけることができません。\n"

#. L_WAX_025
msgid "Lift has been disabled.\n"
msgstr "エレベーターが不能にされた。\n"
