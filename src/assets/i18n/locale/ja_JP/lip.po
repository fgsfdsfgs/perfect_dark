msgstr "カードキーＯｐ\n"

#. L_LIP_063
msgid "Picked up operation room key card.\n"
msgstr "オペルームのカードキーを手に入れた\n"

#. L_LIP_064
msgid "Elvis has been killed.\n"
msgstr "「フレンド」が倒された\n"

#. L_LIP_065
msgid "Get the hell out of here!\n"
msgstr "ここから出ていってくれ！\n"

#. L_LIP_066
msgid "Containment unit raised up.\n"
msgstr "冷凍カプセルが上昇した\n"

#. L_LIP_067
msgid "Containment unit lowered down.\n"
msgstr "冷凍カプセルが下降した\n"

#. L_LIP_068
msgid "Mission critical equipment destroyed.\n"
msgstr "任務遂行に不可欠な要素が破壊された\n"

