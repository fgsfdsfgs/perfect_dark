msgstr "制服\n"

#. L_GUN_251
msgid "Laptop Gun\n"
msgstr "ＰＣガン\n"

#. L_GUN_252
msgid "Remote Mine\n"
msgstr "リモートＢ\n"

#. L_GUN_253
msgid "Shotgun\n"
msgstr "ショット銃\n"

#. L_GUN_254
msgid "Sniper Rifle\n"
msgstr "Ｓライフル\n"

#. L_GUN_255
msgid "Timed Mine\n"
msgstr "時限爆弾\n"
