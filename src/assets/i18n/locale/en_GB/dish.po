msgid "Holo 4 - Unarmed Combat 1\n"
msgstr "Holo 4 - Unarmed Combat 1\n"

#. L_DISH_320
msgid "Holo 5 - Unarmed Combat 2\n"
msgstr "Holo 5 - Unarmed Combat 2\n"

#. L_DISH_321
msgid "Holo 6 - Live Combat 1\n"
msgstr "Holo 6 - Live Combat 1\n"

#. L_DISH_322
msgid "Holo 7 - Live Combat 2\n"
msgstr "Holo 7 - Live Combat 2\n"
