msgstr "Wer sind Sie?\\n"

msgctxt "L_LIP_038"
msgid "Hey - you've got my clothes.\\n"
msgstr "Hey - Sie haben meine Ausrüstung.\\n"

msgctxt "L_LIP_039"
msgid "Help - help!\\n"
msgstr "Hilfe! Hilfe!\\n"

msgctxt "L_LIP_040"
msgid "Don't shoot me!\\n"
msgstr "Nicht schießen!\\n"

msgctxt "L_LIP_041"
msgid "Oh, my God - a gun!\\n"
msgstr "Oh nein, eine Waffe!\\n"

msgctxt "L_LIP_042"
msgid "There's an intruder in the complex.\\n"
msgstr "Es befindet sich ein Eindringling im Komplex.\\n"

msgctxt "L_LIP_043"
msgid "Give me back my clothes - or else!\\n"
msgstr "Geben Sie mir meine Ausrüstung zurück, oder...!\\n"

msgctxt "L_LIP_044"
msgid "Right - you've asked for it!\\n"
msgstr "Na gut, Sie betteln ja förmlich darum!\\n"

msgctxt "L_LIP_045"
msgid "Give me my clothes.\\n"
msgstr "Geben Sie mir meine Ausrüstung.\\n"

msgctxt "L_LIP_046"
msgid "I don't have much time!!!\\n"
msgstr "Ich habe nicht viel Zeit!!!\\n"

msgctxt "L_LIP_047"
msgid "The enemy has discovered the disguise.\\n"
msgstr "Der Feind hat die Tarnung durchschaut.\\n"

msgctxt "L_LIP_048"
