msgctxt "L_WAX_004"
msgid "Locate and escort Cassandra to helipad\n"
msgstr "Eskortieren Sie Cassandra zum Helipad!\n"

msgctxt "L_WAX_005"
msgid "Plant explosive device in lab lift\n"
msgstr "Platzieren Sie den Sprengsatz!\n"

msgctxt "L_WAX_006"
msgid "Eliminate dataDyne Captain\n"
msgstr "Eliminieren Sie den Sicherheitschef!\n"

msgctxt "L_WAX_007"
msgid "Get the hell out of my office...\n"
msgstr "Raus aus meinem Büro!\n"

msgctxt "L_WAX_008"
msgid "Go to the helipad if you want to live.\n"
msgstr "Wenn Sie am Leben bleiben wollen, folgen Sie mir zum Helipad!\n"

msgctxt "L_WAX_009"
msgid "You won't shoot me!\n"
msgstr "Sie werden nicht auf mich schießen!\n"

msgctxt "L_WAX_010"
msgid "How dare you disturb me!\n"
msgstr "Wie können Sie es wagen, mich zu stören?\n"

msgctxt "L_WAX_011"
msgid "You will regret this intrusion, girl.\n"
msgstr "Sie werden es bereuen, hier eingedrungen zu sein.\n"

msgctxt "L_WAX_012"
msgid "If I were you, I'd leave... NOW!\n"
msgstr "Wenn ich Sie wäre, würde ich verschwinden... SOFORT!\n"

msgctxt "L_WAX_013"
msgid "You won't shoot me!\n"
msgstr "Sie werden nicht auf mich schießen!\n"

msgctxt "L_WAX_014"
msgid "Cassandra has been immobilized.\n"
msgstr "Cassandra wurde eliminiert.\n"

msgctxt "L_WAX_015"
msgid "Cassandra has been captured successfully.\n"
msgstr "Cassandra wurde erfolgreich gefangengenommen.\n"

msgctxt "L_WAX_016"
