msgid "Internal security system temporarily disabled.\n"
msgstr "Internes Sicherheitssystem temporär außer Kraft gesetzt.\n"

#. L_AME_077
msgid "External communications hub disabled.\n"
msgstr "Externe Kommunikationssysteme außer Kraft gesetzt.\n"

