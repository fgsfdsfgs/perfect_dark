#. L_DISH_060
msgid ""
"Select the X-Ray Scanner.\n"
"- Hold A Button.\n"
"- Use Control Stick to change selection.\n"
"- Highlight X-Ray Scanner and release A Button.\n"
msgstr ""
"Choisir le Scanner rayons X.\n"
"- Maintenir le bouton A.\n"
"- Utiliser le Stick pour changer de sélection.\n"
"- Choisir le scanner rayons X et relâcher le bouton A.\n"

#. L_DISH_061
msgid ""
"Select the Disguise.\n"
"- Hold A Button.\n"
"- Use Control Stick to change selection.\n"
"- Highlight Disguise and release A Button.\n"
msgstr ""
"Choisir le costume.\n"
"- Maintenir le bouton A.\n"
"- Utiliser le Stick pour changer de sélection.\n"
