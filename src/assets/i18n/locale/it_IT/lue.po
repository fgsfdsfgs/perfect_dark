msgid "Lift access denied - key card needed.\\n"
msgstr "Negato accesso ascensore - Serve tessera\\n"

msgctxt "L_LUE_037"
msgid "Key card accepted - lift operational.\\n"
msgstr "Tessera valida - Ascensore in funzione\\n"

msgctxt "L_LUE_038"
