msgstr "Chi sei?\n"

#. L_EAR_026
msgid "Unacceptable scientist casualties.\n"
msgstr "Vittime inaccettabili: uccisi scienziati\n"

#. L_EAR_027
msgid "Terminal is not active.\n"
msgstr "Terminale non attivo\n"

#. L_EAR_028
