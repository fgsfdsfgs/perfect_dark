msgstr "Ore 0230  15 AGO 2023\n"

msgctxt "L_AME_011"
msgid "Obtain De Vries' necklace.\n"
msgstr "Prendi collana di De Vries.\n"

msgctxt "L_AME_012"
msgid "Cassandra De Vries'\n"
msgstr "Cassandra De Vries:\n"

msgctxt "L_AME_013"
