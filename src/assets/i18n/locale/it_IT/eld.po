msgstr "Distrutto strumento essenziale alla missione.\n"

#. "L_ELD_022"
msgid ""
"Joanna! It's Grimshaw. We've got hackers at \n"
"the villa! You've got to stop them\n"
" before they get to our files.\n"
msgstr ""
"Joanna! Sono Grimshaw. Ci sono degli hacker \n"
"nella villa! Devi fermarli prima che \n"
" mettano le mani sui file.\n"

#. "L_ELD_023"
msgid "Hackers have uploaded vital data.\n"
msgstr "Gli hacker hanno scaricato dati essenziali.\n"

#. "L_ELD_024"
msgid "Hackers have been eliminated.\n"
msgstr "Gli hacker sono stati eliminati.\n"

#. "L_ELD_025"
msgid "Carrington has been rescued.\n"
msgstr "Carrington è stato salvato.\n"

#. "L_ELD_026"
msgid "All objectives not completed - mission failed.\n"
msgstr "MISSIONE FALLITA - Obiettivi incompleti\n"

