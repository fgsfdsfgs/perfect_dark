#. L_LIP_021
msgid "Access to light control systems denied.\n"
msgstr "Negato accesso al sistema comando luci\n"

#. L_LIP_022
msgid "Access to security control systems denied.\n"
msgstr "Negato accesso al sistema comando sicurezza\n"

#. L_LIP_023
msgid "Virus downloaded to console.\n"
