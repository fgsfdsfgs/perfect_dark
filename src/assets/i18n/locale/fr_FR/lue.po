msgid "Explosive has been placed.\n"
msgstr "Explosif placé.\n"

#. "L_LUE_047"
msgid "Intruder detected - security system online.\n"
msgstr "Intrus détecté - systèmes sécurité branchés.\n"

#. "L_LUE_048"
msgid "Obtain explosive.\n"
msgstr "Obtenir explosif.\n"

#. "L_LUE_049"
