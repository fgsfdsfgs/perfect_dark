msgstr "Effacez la conversation du Dr. Caroll.\n"

#. "L_AME_053"
msgid "Don't shoot, don't shoot!\n"
msgstr "Ne...ne tirez pas!\n"

#. "L_AME_054"
msgid "Critical mission object destroyed.\n"
msgstr "Objet crucial détruit.\n"

#. "L_AME_055"
msgid "Unacceptable civilian casualties.\n"
msgstr "Pertes civiles inacceptables.\n"

