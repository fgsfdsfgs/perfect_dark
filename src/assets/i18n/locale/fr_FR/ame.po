msgstr "ACCES REFUSE - mot de passe requis.\n"

#. "L_AME_047"
msgid "Door unlocked.\n"
msgstr "Porte déverrouillée.\n"

#. "L_AME_048"
msgid "DOH!\n"
msgstr "HEIN?!\n"

#. "L_AME_049"
msgid "Unable to download - Data Uplink needed.\n"
msgstr "Erreur télécharg. - Récepteur absent.\n"

