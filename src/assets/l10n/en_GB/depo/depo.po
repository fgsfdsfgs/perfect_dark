msgstr "There's no way through while those \\nlasers are active.\\n"

msgctxt "L_DEPO_061"
msgid "That must be the meeting room up ahead. \\nTime to use the CamSpy.\\n"
msgstr "That must be the meeting room up ahead. \\nTime to use the CamSpy.\\n"

msgctxt "L_DEPO_062"
msgid ""
"The safe's heavily encrypted. \\nThe decoder's gonna take a little "
"longer.\\n"
msgstr ""
"The safe's heavily encrypted. \\nThe decoder's gonna take a little "
"longer.\\n"

msgctxt "L_DEPO_063"
msgid "Time to leave! Let's get to the door I set \\nup earlier.\\n"
msgstr "Time to leave! Let's get to the door I set \\nup earlier.\\n"

