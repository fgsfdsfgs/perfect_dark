        {
            "id": "L_DISH_008",
            "context": "L_DISH_008",
            "string": "Collect Night Vision from table to begin.\n"
        },
        {
            "id": "L_DISH_009",
            "context": "L_DISH_009",
            "string": "Activate the Night Vision.\nLocate the light switch.\nTurn the lights back on.\n"
        },
        {
            "id": "L_DISH_010",
            "context": "L_DISH_010",
            "string": "Collect Data Uplink from table to begin.\n"
        },
        {
            "id": "L_DISH_011",
            "context": "L_DISH_011",
            "string": "Stand next to the terminal and use the Uplink.\n"
        },
        {
            "id": "L_DISH_012",
            "context": "L_DISH_012",
            "string": "You need to be holding the Data Uplink.\n"
        },
        {
            "id": "L_DISH_013",
            "context": "L_DISH_013",
            "string": "Connection established...\n"
        },
        {
            "id": "L_DISH_014",
            "context": "L_DISH_014",
            "string": "Terminal has been successfully hacked.\n"
        },
        {
            "id": "L_DISH_015",
            "context": "L_DISH_015",
            "string": "Connection broken - too far from PC.\n"
        },
        {
            "id": "L_DISH_016",
            "context": "L_DISH_016",
            "string": "Collect ECM Mine from table to begin.\n"
        },
        {
            "id": "L_DISH_017",
            "context": "L_DISH_017",
            "string": "Locate Hub and throw ECM Mine onto Hub.\n"
        },
        {
            "id": "L_DISH_018",
            "context": "L_DISH_018",
            "string": "ECM Mine has been placed incorrectly.\n"
        },
        {
            "id": "L_DISH_019",
            "context": "L_DISH_019",
            "string": "ECM Mine has been placed correctly.\n"
        },
        {
            "id": "L_DISH_020",
            "context": "L_DISH_020",
            "string": "Collect CamSpy from table to begin.\n"
        },
        {
            "id": "L_DISH_021",
            "context": "L_DISH_021",
            "string": "Locate Info Room PC and holograph it.\n"
        },
        {
            "id": "L_DISH_022",
            "context": "L_DISH_022",
            "string": "Info Room PC successfully holographed.\n"
        },
        {
            "id": "L_DISH_023",
            "context": "L_DISH_023",
            "string": "Lights have been reactivated.\n"
        },
        {
            "id": "L_DISH_024",
            "context": "L_DISH_024",
            "string": "Collect Door Decoder from table to begin.\n"
        },
        {
            "id": "L_DISH_025",
            "context": "L_DISH_025",
            "string": "Use Decoder on door pad to unlock it.\n"
        },
        {
            "id": "L_DISH_026",
            "context": "L_DISH_026",
            "string": "You need to be holding the Door Decoder.\n"
        },
        {
            "id": "L_DISH_027",
            "context": "L_DISH_027",
            "string": "Decoder attached. Initiating cracking routines...\n"
        },
        {
            "id": "L_DISH_028",
            "context": "L_DISH_028",
            "string": "Decoding complete. Door has been unlocked.\n"
        },
        {
            "id": "L_DISH_029",
            "context": "L_DISH_029",
            "string": "Collect Tracker from table to begin.\n"
        },
        {
            "id": "L_DISH_030",
            "context": "L_DISH_030",
            "string": "Locate IR Scanner using Tracker.\n"
        },
        {
            "id": "L_DISH_031",
            "context": "L_DISH_031",
            "string": "IR Scanner has been successfully located.\n"
        },
        {
            "id": "L_DISH_032",
            "context": "L_DISH_032",
            "string": "Collect IR Scanner from table to begin.\n"
        },
        {
            "id": "L_DISH_033",
            "context": "L_DISH_033",
            "string": "Locate secret door using IR Scanner.\n"
        },
        {
            "id": "L_DISH_034",
            "context": "L_DISH_034",
            "string": "Secret door has been successfully located.\n"
        },
        {
            "id": "L_DISH_035",
            "context": "L_DISH_035",
            "string": "Collect X-Ray Scanner from table to begin.\n"
        },
        {
            "id": "L_DISH_036",
            "context": "L_DISH_036",
            "string": "Find hidden switches to shut down laser grid.\n"
        },
        {
            "id": "L_DISH_037",
            "context": "L_DISH_037",
            "string": "All laser grids have been deactivated.\n"
        },
        {
            "id": "L_DISH_038",
            "context": "L_DISH_038",
            "string": "Collect Disguise from table to begin.\n"
        },
        {
            "id": "L_DISH_039",
            "context": "L_DISH_039",
            "string": "Fool someone into giving you Cloaking Device.\n"
        },
        {
            "id": "L_DISH_040",
            "context": "L_DISH_040",
            "string": "Cloaking Device successfully retrieved.\n"
        },
        {
            "id": "L_DISH_041",
            "context": "L_DISH_041",
            "string": "Laser Grid 1 has been deactivated.\n"
        },
        {
            "id": "L_DISH_042",
            "context": "L_DISH_042",
            "string": "Laser Grid 2 has been deactivated.\n"
        },
        {
            "id": "L_DISH_043",
            "context": "L_DISH_043",
            "string": "I'm here to pick up the equipment.\n"
        },
        {
            "id": "L_DISH_044",
            "context": "L_DISH_044",
            "string": "Go away, Joanna. You're not fooling anybody!\n"
        },
        {
            "id": "L_DISH_045",
            "context": "L_DISH_045",
            "string": "Here you go. Don't drop it now.\n"
        },
        {
            "id": "L_DISH_046",
            "context": "L_DISH_046",
            "string": "Cloaking Device has been secured successfully.\n"
        },
        {
            "id": "L_DISH_047",
            "context": "L_DISH_047",
            "string": "You're meant to use the Disguise, remember?\n"
        },
        {
            "id": "L_DISH_048",
            "context": "L_DISH_048",
            "string": "You'll have to do better than that, Joanna.\n"
        },
        {
            "id": "L_DISH_049",
            "context": "L_DISH_049",
            "string": "Joanna, where did you spring from?\n"
        },
        {
            "id": "L_DISH_050",
            "context": "L_DISH_050",
            "string": "You have been detected by the camera.\n"
        },
        {
            "id": "L_DISH_051",
            "context": "L_DISH_051",
            "string": "Collect Cloaking Device from table to begin.\n"
        },
        {
            "id": "L_DISH_052",
            "context": "L_DISH_052",
            "string": "Use Cloaking Device and locate Carrington.\n"
        },
        {
            "id": "L_DISH_053",
            "context": "L_DISH_053",
            "string": "I think we can safely say your training\nis now complete!\n"
        },
        {
            "id": "L_DISH_054",
            "context": "L_DISH_054",
            "string": "Mission complete - Device Training passed!\n"
        },
        {
            "id": "L_DISH_055",
            "context": "L_DISH_055",
            "string": "Mission failed - you have been detected.\n"
        },
        {
            "id": "L_DISH_056",
            "context": "L_DISH_056",
            "string": "Select the Uplink.\n- Hold A Button.\n- Use Control Stick to change selection.\n- Highlight Data Uplink and release A Button.\n"
        },
        {
            "id": "L_DISH_057",
            "context": "L_DISH_057",
            "string": "Select the CamSpy.\n- Hold A Button.\n- Use Control Stick to change selection.\n- Highlight CamSpy and release A Button.\n"
        },
        {
            "id": "L_DISH_058",
            "context": "L_DISH_058",
            "string": "Select the Night Vision.\n- Hold A Button.\n- Use Control Stick to change selection.\n- Highlight Night Vision and release A Button.\n"
        },
        {
            "id": "L_DISH_059",
            "context": "L_DISH_059",
            "string": "Select the Door Decoder.\n- Hold A Button.\n- Use Control Stick to change selection.\n- Highlight Door Decoder and release A Button.\n"
        },
        {
            "id": "L_DISH_060",
            "context": "L_DISH_060",
            "string": "Select the X-Ray Scanner.\n- Hold A Button.\n- Use Control Stick to change selection.\n- Highlight X-Ray Scanner and release A Button.\n"
        },
        {
            "id": "L_DISH_061",
            "context": "L_DISH_061",
            "string": "Select the Disguise.\n- Hold A Button.\n- Use Control Stick to change selection.\n- Highlight Disguise and release A Button.\n"
        },
        {
            "id": "L_DISH_062",
            "context": "L_DISH_062",
            "string": "Select the IR Scanner.\n- Hold A Button.\n- Use Control Stick to change selection.\n- Highlight IR Scanner and release A Button.\n"
        },
        {
            "id": "L_DISH_063",
            "context": "L_DISH_063",
            "string": "Select the Tracker.\n- Hold A Button.\n- Use Control Stick to change selection.\n- Highlight Tracker and release A Button.\n"
        },
        {
            "id": "L_DISH_064",
            "context": "L_DISH_064",
            "string": "Select the Cloaking Device.\n- Hold A Button.\n- Use Control Stick to change selection.\n- Highlight Device and release A Button.\n"
        },
        {
            "id": "L_DISH_065",
            "context": "L_DISH_065",
            "string": "Select the ECM Mine.\n- Hold A Button.\n- Use Control Stick to change selection.\n- Highlight ECM Mine and release A Button.\n"
        },
        {
            "id": "L_DISH_066",
            "context": "L_DISH_066",
            "string": "Joanna, it's good to see you.\n"
        },
        {
            "id": "L_DISH_067",
            "context": "L_DISH_067",
            "string": "Come with me.\nI'll walk you round the training rooms.\n"
        },
        {
            "id": "L_DISH_068",
            "context": "L_DISH_068",
            "string": "The information center is through this door.\n"
        },
        {
            "id": "L_DISH_069",
            "context": "L_DISH_069",
            "string": "In here we have the device lab.\n"
        },
        {
            "id": "L_DISH_070",
            "context": "L_DISH_070",
            "string": "This leads to the simulant training room.\n"
        },
        {
            "id": "L_DISH_071",
            "context": "L_DISH_071",
            "string": "This is the firing range, Jo.\n"
        },
        {
            "id": "L_DISH_072",
            "context": "L_DISH_072",
            "string": "This corridor leads down to the hangar.\n"
        },
        {
            "id": "L_DISH_073",
            "context": "L_DISH_073",
            "string": "HOVERCRATE\nPress B Button next to Hovcrate to grab it...\n"
        },
        {
            "id": "L_DISH_074",
            "context": "L_DISH_074",
            "string": "Press B Button when crate grabbed to release it.\n"
        },
        {
            "id": "L_DISH_075",
            "context": "L_DISH_075",
            "string": "HOVERBIKE\nDouble tap B Button next to Hovbike to ride it...\n"
        },
        {
            "id": "L_DISH_076",
            "context": "L_DISH_076",
            "string": "Double tap B Button when on Hovbike to dismount.\n"
        },
        {
            "id": "L_DISH_077",
            "context": "L_DISH_077",
            "string": "OPENING DOORS\nPress B Button next to door to open it.\n"
        },
        {
            "id": "L_DISH_078",
            "context": "L_DISH_078",
            "string": "B Button will also activate any object nearby.\n"
        },
        {
            "id": "L_DISH_079",
            "context": "L_DISH_079",
            "string": "ELEVATORS\nPress B Button next to door to call elevator.\n"
        },
        {
            "id": "L_DISH_080",
            "context": "L_DISH_080",
            "string": "Cannot exit while training is in progress.\n"
        },
        {
            "id": "L_DISH_081",
            "context": "L_DISH_081",
            "string": "Switch Code 1 has been obtained.\n"
        },
        {
            "id": "L_DISH_082",
            "context": "L_DISH_082",
            "string": "Switch Code 2 has been obtained.\n"
        },
        {
            "id": "L_DISH_083",
            "context": "L_DISH_083",
            "string": "Switch Code 3 has been obtained.\n"
        },
        {
            "id": "L_DISH_084",
            "context": "L_DISH_084",
            "string": "Switch Code 4 has been obtained.\n"
        },
        {
            "id": "L_DISH_085",
            "context": "L_DISH_085",
            "string": "LOOK UP\n- Press Down C Button to look up at the target.\n"
        },
        {
            "id": "L_DISH_086",
            "context": "L_DISH_086",
            "string": "LOOK DOWN\n- Press Up C Button to look down at the target.\n"
        },
        {
            "id": "L_DISH_087",
            "context": "L_DISH_087",
            "string": "Holoprogram 2 has been completed successfully.\n"
        },
        {
            "id": "L_DISH_088",
            "context": "L_DISH_088",
            "string": "Holoprogram 4 has been completed successfully.\n"
        },
        {
            "id": "L_DISH_089",
            "context": "L_DISH_089",
            "string": "Holoprogram 5 has been completed successfully.\n"
        },
        {
            "id": "L_DISH_090",
            "context": "L_DISH_090",
            "string": "Guard has been successfully disarmed.\n"
        },
        {
            "id": "L_DISH_091",
            "context": "L_DISH_091",
            "string": "Guard has been successfully knocked out.\n"
        },
        {
            "id": "L_DISH_092",
            "context": "L_DISH_092",
            "string": "Disarm this live target if you can.\n"
        },
        {
            "id": "L_DISH_093",
            "context": "L_DISH_093",
            "string": "Knock out this target - stealth is the key.\n"
        },
        {
            "id": "L_DISH_094",
            "context": "L_DISH_094",
            "string": "And the final guard...\n"
        },
        {
            "id": "L_DISH_095",
            "context": "L_DISH_095",
            "string": "DUCK\n- Hold R Button, then press Down C Button to duck.\n"
        },
        {
            "id": "L_DISH_096",
            "context": "L_DISH_096",
            "string": "CROUCH\n- When ducking, hold R Button, then press Down C Button to duck.\n"
        },
        {
            "id": "L_DISH_097",
            "context": "L_DISH_097",
            "string": "Holoprogram 3 has been completed successfully.\n"
        },
        {
            "id": "L_DISH_098",
            "context": "L_DISH_098",
            "string": "Activate all the switches.\n"
        },
        {
            "id": "L_DISH_099",
            "context": "L_DISH_099",
            "string": "Activate all of the wall switches.\n- Be quick, as they will quickly reset.\n"
        },
        {
            "id": "L_DISH_100",
            "context": "L_DISH_100",
            "string": "Get the access codes by examining terminals.\n- Use the codes on the wall terminals.\n"
        },
        {
            "id": "L_DISH_101",
            "context": "L_DISH_101",
            "string": "Code 1 has been obtained.\n"
        },
        {
            "id": "L_DISH_102",
            "context": "L_DISH_102",
            "string": "Code 2 has been obtained.\n"
        },
        {
            "id": "L_DISH_103",
            "context": "L_DISH_103",
            "string": "Code 3 has been obtained.\n"
        },
        {
            "id": "L_DISH_104",
            "context": "L_DISH_104",
            "string": "Code 4 has been obtained.\n"
        },
        {
            "id": "L_DISH_105",
            "context": "L_DISH_105",
            "string": "Training failed - you must face forward.\n"
        },
        {
            "id": "L_DISH_106",
            "context": "L_DISH_106",
            "string": "Holoprogram 1 has been completed successfully.\n"
        },
        {
            "id": "L_DISH_107",
            "context": "L_DISH_107",
            "string": "Unarmed combat - knock out the target.\n- Press Z Button repeatedly to punch.\n"
        },
        {
            "id": "L_DISH_108",
            "context": "L_DISH_108",
            "string": "Now try against a moving target...\n"
        },
        {
            "id": "L_DISH_109",
            "context": "L_DISH_109",
            "string": "And finally against a target that fights back.\n"
        },
        {
            "id": "L_DISH_110",
            "context": "L_DISH_110",
            "string": "Defeat all enemies without getting hit.\n"
        },
        {
            "id": "L_DISH_111",
            "context": "L_DISH_111",
            "string": "Training failed - you have been hit.\n"
        },
        {
            "id": "L_DISH_112",
            "context": "L_DISH_112",
            "string": "Holoprogram 6 has been completed successfully.\n"
        },
        {
            "id": "L_DISH_113",
            "context": "L_DISH_113",
            "string": "Holoprogram 7 has been completed successfully.\n"
        },
        {
            "id": "L_DISH_114",
            "context": "L_DISH_114",
            "string": "TERMINALS\n- Press B Button next to terminal to use it.\n"
        },
        {
            "id": "L_DISH_115",
            "context": "L_DISH_115",
            "string": "Now activate the red terminals on the wall.\n"
        },
        {
            "id": "L_DISH_116",
            "context": "L_DISH_116",
            "string": "PP7\n"
        },
        {
            "id": "L_DISH_117",
            "context": "L_DISH_117",
            "string": "TT33\n"
        },
        {
            "id": "L_DISH_118",
            "context": "L_DISH_118",
            "string": "Skorpion\n"
        },
        {
            "id": "L_DISH_119",
            "context": "L_DISH_119",
            "string": "AK47\n"
        },
        {
            "id": "L_DISH_120",
            "context": "L_DISH_120",
            "string": "Uzi 9mm\n"
        },
        {
            "id": "L_DISH_121",
            "context": "L_DISH_121",
            "string": "MP5K\n"
        },
        {
            "id": "L_DISH_122",
            "context": "L_DISH_122",
            "string": "M-16\n"
        },
        {
            "id": "L_DISH_123",
            "context": "L_DISH_123",
            "string": "FNP90\n"
        },
        {
            "id": "L_DISH_124",
            "context": "L_DISH_124",
            "string": "Okay, Jo, I'll leave you to prepare for the mission.\n"
        },
        {
