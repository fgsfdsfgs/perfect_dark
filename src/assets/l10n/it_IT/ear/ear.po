msgstr "Presa Vista Notturna\\n"

msgctxt "L_EAR_050"
msgid "Obtain shield tech item.\\n"
msgstr "Procurati strum. tecn. scudo\\n"

msgctxt "L_EAR_051"
msgid "Cassandra De Vries'\\n"
msgstr "Cassandra De Vries:\\n"

msgctxt "L_EAR_052"
msgid "Shield tech item\\n"
msgstr "Strum. tecn. scudo\\n"

