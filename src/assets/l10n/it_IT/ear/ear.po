msgstr "Non sparare! Ti aiuterò!\\n"

msgctxt "L_EAR_033"
msgid "What the hell are you doing in my lab?\\n"
msgstr "Cosa diavolo ci fai nel mio laboratorio?\\n"

msgctxt "L_EAR_034"
msgid "Let me help you.\\n"
msgstr "Ti darò una mano.\\n"

msgctxt "L_EAR_035"
msgid "Accidents will happen.\\n"
msgstr "Eh sì! Succede...\\n"

msgctxt "L_EAR_036"
msgid "ACCESS DENIED - security code required.\\n"
msgstr "ACCESSO NEGATO: inserire codice di sicurezza\\n"

msgctxt "L_EAR_037"
