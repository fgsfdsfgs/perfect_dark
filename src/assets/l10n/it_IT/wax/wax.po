msgid "Skedar bomb has been placed successfully.\\n"
msgstr "La bomba Skedar è in posizione corretta.\\n"

msgctxt "L_WAX_023"
msgid "Skedar bomb has detonated.\\n"
msgstr "La bomba Skedar è esplosa.\\n"

msgctxt "L_WAX_024"
msgid "Lift doors locked - bomb cannot be placed.\\n"
msgstr "Porte ascensore bloccate: impossibile piazzare bomba.\\n"

