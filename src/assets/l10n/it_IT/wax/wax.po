msgctxt "L_WAX_004"
msgid "Locate and escort Cassandra to helipad\\n"
msgstr "Scova e scorta De Vries all'eliporto\\n"

msgctxt "L_WAX_005"
msgid "Plant explosive device in lab lift\\n"
msgstr "Piazza ordigno esplosivo in ascensore\\n"

msgctxt "L_WAX_006"
msgid "Eliminate dataDyne Captain\\n"
msgstr "Elimina il presidente dataDyne\\n"

msgctxt "L_WAX_007"
msgid "Get the hell out of my office...\\n"
msgstr "Esci subito dal mio ufficio...\\n"

msgctxt "L_WAX_008"
msgid "Go to the helipad if you want to live.\\n"
msgstr "Va all'eliporto se tieni alla pelle!\\n"

msgctxt "L_WAX_009"
msgid "You won't shoot me!\\n"
msgstr "Non vorrai mica spararmi...\\n"

msgctxt "L_WAX_010"
msgid "How dare you disturb me!\\n"
msgstr "Come osi disturbarmi!\\n"

msgctxt "L_WAX_011"
msgid "You will regret this intrusion, girl.\\n"
msgstr "Te ne pentirai amaramente, sfacciata!\\n"

msgctxt "L_WAX_012"
msgid "If I were you, I'd leave... NOW!\\n"
msgstr "Se fossi in te girerei al largo!\\n"

msgctxt "L_WAX_013"
msgid "You won't shoot me!\\n"
msgstr "Non vorrai mica spararmi...\\n"

msgctxt "L_WAX_014"
msgid "Cassandra has been immobilized.\\n"
msgstr "Cassandra è immobilizzata!\\n"

msgctxt "L_WAX_015"
msgid "Cassandra has been captured successfully.\\n"
msgstr "Cassandra è stata catturata!\\n"

msgctxt "L_WAX_016"
msgid "Security chief has been eliminated.\\n"
msgstr "Il capo della sicurezza è stato eliminato.\\n"

