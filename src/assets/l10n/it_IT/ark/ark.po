msgctxt "L_ARK_009"
msgid "Access foyer elevator\\n"
msgstr "Usa l'ascensore dell'atrio\\n"

msgctxt "L_ARK_010"
msgid "Reactivate office elevator\\n"
msgstr "Riattiva l'ascensore degli uffici\\n"

msgctxt "L_ARK_011"
msgid "Destroy dataDyne hovercopter\\n"
msgstr "Distruggi la cannoniera dataDyne\\n"

msgctxt "L_ARK_012"
msgid "Defeat Cassandra's bodyguards\\n"
msgstr "Elimina guardie del corpo di Cassandra\\n"

msgctxt "L_ARK_013"
msgid "Rendezvous at helipad\\n"
msgstr "Appuntamento all'eliporto\\n"

msgctxt "L_ARK_014"
msgid "Accessing elevator controls...\\n"
msgstr "I comandi dell'ascensore...\\n"

msgctxt "L_ARK_015"
msgid "LIGHTS ARE NOW ON!\\n"
msgstr "LE LUCI SONO ACCESE!\\n"

msgctxt "L_ARK_016"
msgid "Dr. Caroll has been killed!\\n"
msgstr "Il Dr. Caroll è stato ucciso!\\n"

msgctxt "L_ARK_017"
msgid "Dr. Caroll is under attack!\\n"
msgstr "Attaccano il Dr. Caroll!\\n"

msgctxt "L_ARK_018"
msgid "Dr. Caroll has been damaged!\\n"
msgstr "Il Dr. Caroll è ferito!\\n"

msgctxt "L_ARK_019"
msgid "Too late! She's here...\\n"
msgstr "Troppo tardi! È già qui!\\n"

msgctxt "L_ARK_020"
msgid "You've become quite an annoyance...\\n"
msgstr "Sei una vera scocciatura!\\n"

msgctxt "L_ARK_021"
msgid "Good night, Ms. Dark.\\n"
msgstr "Buona notte, Perfect Dark!\\n"

msgctxt "L_ARK_022"
msgid "LIGHTS NOW ON\\n"
msgstr "LUCI ACCESE ORA\\n"

msgctxt "L_ARK_023"
msgid "LIGHTS NOW OFF\\n"
msgstr "LUCI SPENTE ORA\\n"

msgctxt "L_ARK_024"
msgid "MISSION FAILED\\n"
msgstr "MISSIONE FALLITA\\n"

msgctxt "L_ARK_025"
msgid "MISSION SUCCESSFUL\\n"
msgstr "MISSIONE COMPIUTA\\n"

msgctxt "L_ARK_026"
msgid "Helichopper warning goes here.\\n"
msgstr "Allarme cannoniera!\\n"

msgctxt "L_ARK_027"
msgid "Obtain Night Vision.\\n"
msgstr "Procurati Vista Notturna\\n"

msgctxt "L_ARK_028"
msgid "Cassandra De Vries'\\n"
msgstr "Cassandra De Vries:\\n"

msgctxt "L_ARK_029"
msgid "Night Vision\\n"
msgstr "Vista Notturna\\n"

msgctxt "L_ARK_030"
msgid "Night Vision\\n"
msgstr "Vista Notturna\\n"

msgctxt "L_ARK_031"
msgid "Picked up Night Vision.\\n"
msgstr "Presa Vista Notturna\\n"

msgctxt "L_ARK_032"
msgid "We meet again, girl!\\n"
msgstr "Chi non muore si rivede!\\n"

msgctxt "L_ARK_033"
msgid "Foyer elevator accessed.\\n"
msgstr "Raggiunto l'ascensore nell'atrio.\\n"

msgctxt "L_ARK_034"
msgid "Office elevator door has been unlocked.\\n"
msgstr "Aperta la porta ascensore uffici.\\n"

msgctxt "L_ARK_035"
msgid "DataDyne Hovercopter eliminated.\\n"
msgstr "Eliminata la cannoniera dataDyne.\\n"

msgctxt "L_ARK_036"
msgid "Cassandra's bodyguards have been defeated.\\n"
msgstr "Sconfitte le guardie del corpo di Cassandra.\\n"

msgctxt "L_ARK_037"
msgid "That's not how it goes.\\n"
msgstr "Non si fa così, idiota!\\n"

msgctxt "L_ARK_038"
msgid "Yes, it is.\\n"
msgstr "Sì, invece!\\n"

msgctxt "L_ARK_039"
msgid "Give it to me - you're doing it wrong.\\n"
msgstr "Dammi qua! Faccio io!\\n"

msgctxt "L_ARK_040"
msgid "Stop annoying me.\\n"
msgstr "Non scocciarmi!\\n"

msgctxt "L_ARK_041"
msgid "Will you just hurry up!\\n"
msgstr "Ti vuoi dare una mossa?!\\n"

msgctxt "L_ARK_042"
msgid "Oh, no...too late.\\n"
msgstr "Oh, no! Troppo tardi.\\n"

msgctxt "L_ARK_043"
msgid "She's here...\\n"
msgstr "Ci ha raggiunti...\\n"

msgctxt "L_ARK_044"
msgid "Get her!\\n"
msgstr "Prendila!\\n"

msgctxt "L_ARK_045"
msgid "Critical mission object destroyed. \\n"
msgstr "Distrutto strumento essenziale alla missione\\n"

msgctxt "L_ARK_046"
msgid "Obtain CamSpy.\\n"
msgstr "Procurati TeleSpia.\\n"

msgctxt "L_ARK_047"
msgid "Dr. Caroll's\\n"
msgstr "Dr. Caroll:\\n"

msgctxt "L_ARK_048"
msgid "CamSpy\\n"
msgstr "TeleSpia\\n"

msgctxt "L_ARK_049"
msgid "A CamSpy\\n"
msgstr "TeleSpia\\n"

msgctxt "L_ARK_050"
msgid "Picked up a CamSpy.\\n"
msgstr "Presa la TeleSpia.\\n"

msgctxt "L_ARK_051"
msgid "They've locked down the ground floor - \\nget to the elevator!\\n"
msgstr "Hanno chiuso il pianterreno! \\nVa all'ascensore!\\n"

msgctxt "L_ARK_052"
msgid "That copter needs to be taken out, or \\nthe jumpship'll get shot down!\\n"
msgstr "Bisogna tirar giù quella cannoniera \\no abbatterà la navetta!\\n"

msgctxt "L_ARK_053"
msgid "I can't leave any bodyguards standing.\\n"
msgstr "Non posso lasciar vive le guardie!\\n"

msgctxt "L_ARK_054"
msgid "Don't keep the jumpship waiting - \\nget back to the landing pad.\\n"
msgstr "Fai presto: vai alla navetta! \\nTorna all'eliporto!\\n"

msgctxt "L_ARK_055"
msgid "Obtain alpha key card.\\n"
msgstr "Procurati la chiave alfa\\n"

msgctxt "L_ARK_056"
msgid "Guard's\\n"
msgstr "Guardia:\\n"

msgctxt "L_ARK_057"
msgid "Office key card\\n"
msgstr "Chiave dell'ufficio\\n"

msgctxt "L_ARK_058"
msgid "Office key card\\n"
msgstr "Chiave dell'ufficio\\n"

msgctxt "L_ARK_059"
msgid "Picked up Cassandra's office key card.\\n"
msgstr "Presa chiave ufficio di Cassandra\\n"

msgctxt "L_ARK_060"
msgid "Sound the alarm - she's here!\\n"
msgstr "Date l'allarme: è qui!\\n"

msgctxt "L_ARK_061"
msgid "Lights out!\\n"
msgstr "Ma chiudi il becco!\\n"

msgctxt "L_ARK_062"
msgid "What the...?\\n"
msgstr "Ma cosa...?\\n"

msgctxt "L_ARK_063"
msgid "Going somewhere?\\n"
msgstr "Dove credi di andare?\\n"

msgctxt "L_ARK_064"
msgid "Something I can do for you, old woman?\\n"
msgstr "Posso aiutarla, madama?\\n"

msgctxt "L_ARK_065"
msgid "Return our sapient immediately! You don't \\nknow what you're doing.\\n"
msgstr "Ridacci immediatamente il Sapiente! \\nNon sai quel che fai!\\n"

msgctxt "L_ARK_066"
msgid "Yes I do. I'm leaving.\\n"
msgstr "Certo che lo so: me ne vado!\\n"

msgctxt "L_ARK_067"
msgid "One more chance! Give it back, and you \\ncould come and work for me.\\n"
msgstr "Te lo ripeto! Restituiscilo e \\npotrai venire a lavorare per me.\\n"

msgctxt "L_ARK_068"
msgid "Sorry! Gotta shoot.\\n"
msgstr "Spiacente! Ho da fare!\\n"

msgctxt "L_ARK_069"
msgid "You must get the sapient back. We cannot \\nproceed without it.\\n"
msgstr "Devi recuperare il Sapiente: senza \\nnon è possibile andare avanti.\\n"

msgctxt "L_ARK_070"
msgid "I know that!\\n"
msgstr "Lo so benissimo!\\n"

msgctxt "L_ARK_071"
msgid "I also know who to talk to... \\nMr. Carrington.\\n"
msgstr "So anche con chi parlare... \\ncon Carrington!\\n"

msgctxt "L_ARK_072"
msgid "Elevator door is inactive on this floor.\\n"
msgstr "La porta dell'ascensore è fuori servizio.\\n"
