msgctxt "L_EAR_096"
msgid "Reprogram that cleaning bot - \\nit'll give you a way in.\\n"
msgstr "Reprograma ese robot de limpieza: \\nte permitirá entrar.\\n"

msgctxt "L_EAR_097"
msgid "Get out, Jo! The levels are too high. \\nUse the CamSpy.\\n"
msgstr "¡Sal, Joanna! Los niveles son demasiado altos. \\nUsa la Cámara Espía.\\n"

msgctxt "L_EAR_098"
msgid "Secret weapons compartment opened.\\n"
msgstr "Compartimento de armas secreto abierto.\\n"

msgctxt "L_EAR_099"
msgid "Enemy detected - weapon cache locked.\\n"
msgstr "Enemigo detectado: arsenal de armas cerrado.\\n"

msgctxt "L_EAR_100"
msgid "Dr. Caroll?\\n"
msgstr "¿Dr. Caroll?\\n"

msgctxt "L_EAR_101"
msgid "Dr. Caroll, are you here?\\n"
msgstr "Dr. Caroll, ¿está usted aquí?\\n"

msgctxt "L_EAR_102"
msgid "Well, is it safe to come out?\\n"
msgstr "Pero, ¿es seguro salir?\\n"

msgctxt "L_EAR_103"
msgid "Yes, all clear.\\n"
msgstr "Sí, todo despejado.\\n"

msgctxt "L_EAR_104"
msgid "Wh..what... you're...\\n"
msgstr "¿Qu... qué... eres...?\\n"

msgctxt "L_EAR_105"
msgid ""
"Very professionally done, my dear, but there's \\nno time to waste! We must "
"leave immediately!\\n"
msgstr ""
"¡Muy profesional, querida, pero no hay tiempo \\nque perder! ¡Debemos irnos "
"inmediatamente!\\n"

msgctxt "L_EAR_106"
msgid "Come on. I have vital information, and you \\nmust protect me.\\n"
msgstr "Vamos. Tengo información vital, y tú \\ndebes protegerme.\\n"
